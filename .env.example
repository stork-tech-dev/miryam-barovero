SECRET_KEY=django-insecure-miryam-dev-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Docker Compose (Postgres): copiá estas líneas a .env o usá los defaults del compose.
DB_ENGINE=postgresql
DB_NAME=miryam
DB_USER=miryam
DB_PASSWORD=miryam
DB_HOST=db
DB_PORT=5432

# Sin Docker (solo runserver local): descomentá y omití DB_HOST/USER/PASSWORD arriba.
# DB_ENGINE=sqlite3
